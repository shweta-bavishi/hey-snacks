{
  "name": "hey-snacks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "capture:pack3d": "node scripts/capture-pack-3d.mjs",
    "remotion": "remotion studio --port 3001",
    "render:hero": "remotion render HeroLightRake out/hero-light-rake.mp4 --codec=h264 --crf=26",
    "render:hero:webm": "remotion render HeroLightRake out/hero-light-rake.webm --codec=vp9 --crf=34",
    "render:hero:poster": "remotion still HeroLightRake out/hero-light-rake-poster.png --frame=250",
    "render:banner": "remotion still HeroBanner out/banner-night.png",
    "render:banner:paper": "remotion still HeroBannerPaper out/banner-paper.png"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
